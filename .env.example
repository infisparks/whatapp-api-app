# ==============================================================================
# WhatsApp Business Platform - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta App & Embedded Signup Configuration (Official Meta Values)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_META_APP_ID=3457567954401110
META_APP_ID=3457567954401110
META_EMBEDDED_SIGNUP_CONFIG_ID=1084755870646567
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=1084755870646567
META_GRAPH_API_VERSION=v26.0
NEXT_PUBLIC_META_JS_SDK_VERSION=v26.0

# [ACTION REQUIRED]: Meta App Secret from Meta Developer Dashboard -> App Settings -> Basic
META_APP_SECRET=

# [ACTION REQUIRED]: System User Access Token with whatsapp_business_messaging permissions
META_SYSTEM_USER_TOKEN=
META_SYSTEM_USER_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 2. Meta Webhook Configuration
# ------------------------------------------------------------------------------
# [ACTION REQUIRED]: Verification token chosen by you and entered in Meta Webhook config
META_WEBHOOK_VERIFY_TOKEN=

# External Webhook URL configured in Meta App Dashboard
WHATSAPP_WEBHOOK_URL=https://aiwh.infiplus.in/api/v1/whatsapp/webhook
META_WEBHOOK_CALLBACK_URL=https://aiwh.infiplus.in/api/v1/whatsapp/webhook

# ------------------------------------------------------------------------------
# 3. Application & OAuth Settings
# ------------------------------------------------------------------------------
APP_URL=https://aiwh.infiplus.in
NEXT_PUBLIC_APP_URL=https://aiwh.infiplus.in
META_OAUTH_REDIRECT_URI=https://aiwh.infiplus.in/dashboard/whatsapp/connect

# ------------------------------------------------------------------------------
# 4. Database Connection (PostgreSQL with Prisma)
# ------------------------------------------------------------------------------
# [ACTION REQUIRED]: Your PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_db?schema=public

# ------------------------------------------------------------------------------
# 5. Security & Token Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# [ACTION REQUIRED]: 32-byte hex string (64 characters) or 32+ char secret for encrypting stored access tokens
ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=

# Session / JWT Secret for Multi-Tenant Auth
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://aiwh.infiplus.in
